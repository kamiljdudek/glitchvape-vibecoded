Priority: optional
Maintainer: Kamil J. Dudek <kamilek@localhost.localdomain>
Rules-Requires-Root: no
Build-Depends:
 debhelper-compat (= 13),
 perl,
# The suite is Perl-only apart from the effects, which need ImageMagick both
# as a library and as a binary -- GlitchVape::Tools shells out to `magick` for
# the things PerlMagick cannot do in-process. The window tests skip themselves
# when there is no display, so nothing here needs X.
 imagemagick <!nocheck>,
 libimage-magick-perl <!nocheck>,
 libfile-which-perl <!nocheck>,
# A preset is YAML, so without a parser every test that loads one fails. It
# is here rather than assumed because a buildd chroot has what is asked for
# and nothing else -- the same reason the RPM spec names it.
 libyaml-libyaml-perl <!nocheck>,
# The cjk role is the one with no bundled candidate to fall through to, so
# `text` and `watermark` die rather than render differently when nothing
# satisfies it -- and a buildd chroot satisfies nothing it was not told to.
# fontconfig as well as the font, because fc-list is how a system font is
# found at all.
 fontconfig <!nocheck>,
 fonts-noto-cjk <!nocheck>,
Standards-Version: 4.7.0
Homepage: https://github.com/kamiljdudek/glitchvape-vibecoded
Vcs-Browser: https://github.com/kamiljdudek/glitchvape-vibecoded
